{
  "name": "otcf-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm content:build --drafts && concurrently -k -n web,api -c blue,magenta \"react-router dev\" \"tsx watch server/node.ts\"",
    "build": "pnpm content:check && pnpm content:build && react-router build",
    "start": "NODE_ENV=production tsx server/node.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/content-check.ts",
    "typecheck": "pnpm content:build && react-router typegen && tsc",
    "lint": "eslint .",
    "api:dev": "pnpm content:build && wrangler dev",
    "api:deploy": "pnpm content:build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.16.1",
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gray-matter": "4.0.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "wrangler": "4.157.0",
    "zod": "4.6.7"
  }
}
