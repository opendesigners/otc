# Copy to .env.local for local development. Build-time values (site URL,
# email, socials, drafts) are set in Cloudflare Pages → Settings → Variables.
# Runtime values for the API (key, model) are set on the Worker.

# --- Site (build time; printed into the static HTML) -------------------------
# Public origin of the site, no trailing slash. Used for canonical URLs,
# OpenGraph, sitemap.xml and robots.txt.
SITE_URL=http://localhost:5173

# OTCF's public inbox. Shown on /contact, /partner and /about, and used by the
# assistant when it can't answer. Leave blank to hide email CTAs.
OTCF_CONTACT_EMAIL=

# Social links (optional; blank = hidden).
OTCF_SOCIAL_X=
OTCF_SOCIAL_LINKEDIN=
OTCF_SOCIAL_INSTAGRAM=
OTCF_SOCIAL_GITHUB=
OTCF_SOCIAL_YOUTUBE=

# Content with `publish: false` always shows in `pnpm dev`. Set to "true" on a
# preview build to review drafts there. Never set it for production.
OTCF_SHOW_DRAFTS=false

# --- API (runtime; server/) ----------------------------------------------------
# Without a key the site still works: /api/ask falls back to keyword search over
# the content and the UI shows "Here's where to look".
# On Cloudflare: `pnpm exec wrangler secret put ANTHROPIC_API_KEY`
# (local `wrangler dev` reads .dev.vars instead of this file).
ANTHROPIC_API_KEY=
# Model ID. Defaults to claude-haiku-5-5 if unset.
OTCF_MODEL=claude-haiku-5-5

# Port for the local Node API in `pnpm dev` (Vite proxies /api here) and for
# `pnpm start` on a VPS.
OTCF_API_PORT=8787
